<div class="modal payment-modal">
    <div class="modal-box">
        <button class="close-modal close">✕</button>

        <h2>Xác nhận thuê</h2>

        <p>
            Vui lòng kiểm tra thông tin trước khi thanh toán.
        </p>

        <form asp-controller="Account" asp-action="ThuePhong" method="post" class="modal-form">

            <input type="text" name="TenNguoiDung" placeholder="Tên đăng ký" autocomplete="off" />

            <input type="password" name="MatKhau" placeholder="Mật khẩu" />

            <div class="bill">
                <div class="bill-row">
                    <span>Phòng</span>

                    <select id="phongSelect" name="PhongId">
                        @foreach (var phong in ViewBag.PhongTrong)
                        {
                            <option value="@phong.Id" data-tienhangthang="@phong.TienHangThang"
                                    data-tiendatcoc="@phong.TienDatCoc">
                                @phong.TenPhong
                            </option>
                        }
                    </select>
                </div>

                <div class="bill-row">
                    <span>Tiền phòng</span>
                    <strong id="tienPhong"></strong>
                </div>

                <div class="bill-row">
                    <span>Tiền cọc</span>
                    <strong id="tienCoc"></strong>
                </div>

                <div class="bill-row total">
                    <span>Tổng cộng</span>
                    <strong id="tongTien"></strong>
                </div>
            </div>
            @if (TempData["ThuePhongError"] != null)
            {
                <p style="color:red;">
                    @TempData["ThuePhongError"]
                </p>
            }
            <button type="submit" class="confirm-payment tour-btn">
                Xác nhận thanh toán
            </button>

        </form>

    </div>
</div>
@if (TempData["ThuePhongError"] != null)
{
    <script>
        window.addEventListener("load", function () {

            const paymentModal =
                document.querySelector(".payment-modal");

            if (paymentModal) {
                paymentModal.classList.add("active");
            }

        });
    </script>
}