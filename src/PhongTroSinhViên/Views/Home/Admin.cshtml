@model List<MyMvcApp.Models.PhongTro>
@{
    ViewData["Title"] = "Admin";
}

@Html.Partial("_SettingModal")

<div class="admin-layout">

    @Html.Partial("_Sidebar")

    <div class="admin-content">

        <div class="admin-top">

            <div>
                <h1 class="title">Quản lý nhà trọ</h1>
            </div>

        </div>

        <div class="card">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Số phòng</th>
                        <th>Người thuê</th>
                        <th>Tiền nước</th>
                        <th>Tiền điện</th>
                        <th>Đóng tiền</th>
                        <th>Tình trạng</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (PhongTro item in Model)
                    {
                        <tr>

                            <td>@item.Id</td>

                            <td style="color:@(item.NguoiSoHuu != null ? "" : "red")">
                                @(item.NguoiSoHuu != null
                                    ? item.NguoiSoHuu.TenNguoiDung
                                    : "Trống")
                            </td>

                            <td>@item.LuongNuoc</td>

                            <td>@item.LuongDien</td>

                            <td style="color:@(item.TinhTrangDongTien ? "green" : "red")">

                                @(item.TinhTrangDongTien
                                    ? "Đã đóng"
                                    : "Chưa đóng")

                            </td>

                            <td>

                                <button class="setting" data-id="@item.Id" data-ten="@(item.NguoiSoHuu?.TenNguoiDung ?? "")"
                                        data-nuoc="@item.LuongNuoc" data-dien="@item.LuongDien" data-tien="@item.TienHangThang"
                                        data-dongtien="@item.TinhTrangDongTien.ToString().ToLower()">
                                    Chỉnh sửa
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
            <div class="admin-pagination">

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <button onclick="location.href='?page=@i'" class="@(i == ViewBag.CurrentPage ? "active" : "")">

                        @i

                    </button>
                }

            </div>
        </div>

    </div>

</div>