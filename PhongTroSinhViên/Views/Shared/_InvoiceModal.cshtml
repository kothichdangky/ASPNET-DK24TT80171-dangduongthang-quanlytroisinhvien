<div class="modal invoice-modal">
    <div class="invoice-box">
        <button class="close-modal close">✕</button>

        <h2>Hoá đơn thanh toán</h2>

        <div class="invoice-status">
            Thanh toán thành công
        </div>

        <div class="bill">

            <div class="bill-row">
                <span>Mã hoá đơn</span>
                <strong>@TempData["HoaDonId"]</strong>
            </div>

            <div class="bill-row">
                <span>Phòng</span>
                <strong>@TempData["TenPhong"]</strong>
            </div>

            <div class="bill-row">
                <span>Ngày thanh toán</span>
                <strong>@TempData["NgayThanhToan"]</strong>
            </div>

            <div class="bill-row total">
                <span>Tổng tiền</span>
               <strong>@TempData["TongTien"] đ</strong>
            </div>

        </div>

        <button class="tour-btn close">
            Hoàn tất
        </button>
    </div>
</div>