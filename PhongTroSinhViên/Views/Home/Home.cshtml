@model MyMvcApp.Models.PhongTro
@{
    ViewData["Title"] = "Home";
}

@Html.Partial("_FixModal")

@Html.Partial("_Correct")

@Html.Partial("_CheckModal")

@Html.Partial("_InvoiceModal")

@Html.Partial("_PaymentModal2")

<div class="content">

    <div class="card" style="width: 100%">

        <h1 class="title">Phòng @Model.Id:</h1>

        <div>

            @if ((DateTime)ViewBag.NgayThuTien <= DateTime.Today)
            {
                <p class="address" style="color:red;">
                    Đã hết hạn tiền tháng, cần thanh toán gấp !
                    (@(((DateTime)ViewBag.NgayThuTien).ToString("dd/MM/yyyy")))
                </p>
            }
            else
            {
                <p class="address">
                    Ngày chi trả tiếp theo:
                    @(((DateTime)ViewBag.NgayThuTien).ToString("dd/MM/yyyy"))
                </p>
            }

            <div class="stats">

                <div class="stat">
                    <h3>Lượng nước</h3>
                    <h2>@Model.LuongNuoc</h2>
                </div>

                <div class="stat">
                    <h3>Lượng điện</h3>
                    <h2>@Model.LuongDien</h2>
                </div>

                <div class="stat">
                    <h3>Tiền tháng</h3>
                    <h2>@Model.TienHangThang đ</h2>
                </div>

                <div class="stat">
                    <h3>Tiền đặt cọc</h3>
                    <h2>@Model.TienDatCoc đ</h2>
                </div>

            </div>

            <div class="stats">

                <div class="stat">
                    <h3>yêu cầu sửa chữa</h3>
                    <button class="tour-btn request">
                        gửi yêu cầu
                    </button>
                </div>

                <div class="stat">
                    <h4>Kiểm tra hoá đơn</h4>
                    <button class="tour-btn check">
                        kiểm tra
                    </button>
                </div>

                <div class="stat">
                    <h4>Thanh toán tiền tháng</h4>
                    <button class="tour-btn hire-2" data-tienphong="@Model.TienHangThang" data-nuoc="@Model.LuongNuoc"
                            data-dien="@Model.LuongDien">
                        Thanh toán
                    </button>
                </div>

            </div>

        </div>

    </div>

</div>
@if (TempData["Success"] != null)
{
    <script>
        window.addEventListener("load", function () {

            const invoiceModal =
                document.querySelector(".invoice-modal");

            if (invoiceModal) {

                invoiceModal.classList.add("active");

            }

        });
    </script>
}
@if (ViewBag.OpenModal == true)
{
    <script>
        window.addEventListener("load", function () {

            const checkModal =
                document.querySelector(".check-modal");

            if (checkModal) {

                checkModal.classList.add("active");

            }

        });
    </script>
}

@if (TempData["FixSuccess"] != null)
{
    <script>
        window.addEventListener("load", function () {

            const correctModal =
                document.querySelector(".correct-modal");

            if (correctModal) {

                correctModal.classList.add("active");

            }

        });
    </script>
}