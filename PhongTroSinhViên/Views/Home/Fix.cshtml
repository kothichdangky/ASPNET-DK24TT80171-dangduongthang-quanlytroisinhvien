@model List<MyMvcApp.Models.SuaChua>
@{
    ViewData["Title"] = "Fix";
}

@Html.Partial("_DetailModal")

<div class="admin-layout">

    @Html.Partial("_Sidebar")

    <div class="admin-content">

        <div class="admin-top">

            <div>
                <h1 class="title">
                    Yêu cầu sữa chữa
                </h1>
            </div>

        </div>

        <div class="card">

           

            <table class="admin-table">

                <thead>

                    <tr>
                        <th>Số phòng</th>
                        <th>Người thuê</th>
                        <th>Vấn đề</th>
                        <th>Ngày yêu cầu</th>
                        <th>Tình trạng</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.PhongId
                            </td>

                            <td>
                                @item.NguoiThue?.TenNguoiDung
                            </td>

                            <td>
                                <div class="limit-text">
                                    @item.NoiDung
                                </div>
                            </td>

                            <td>
                                @item.NgayYeuCau.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                <button class="detail" data-id="@item.Id" data-phong="@item.PhongId"
                                        data-ngay="@item.NgayYeuCau.ToString("dd/MM/yyyy")" data-noidung="@item.NoiDung">
                                    Chi tiết
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div class="admin-pagination">

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <button onclick="location.href='/Home/Fix?page=@i'" class="@(i == ViewBag.CurrentPage ? "active" : "")">

                        @i

                    </button>
                }

            </div>

        </div>

    </div>

</div>